# ──── Raaz ────
.env
.env.*
app/credentials.json
app/token.json

# ──── Vector store (dobara ban jata hai) ────
app/chroma_db/
chroma_db/

# ──── Python ka kachra ────
__pycache__/
*.pyc

# ──── User ka data — kabhi repo mein nahi jana chahiye ────
# Employees ki face photos aur company ki policy documents.
# Yeh pehle .gitignore mein NAHI thin — ek `git add .` in ko hamesha
# ke liye git history mein daal deta.
app/uploads/
uploads/

# ──── Database dumps ────
# A pg_dump holds every password hash, salary and medical certificate in
# the system. `migrate_multitenant.py` suggests taking one before it
# runs, so this makes sure the suggestion cannot end up in the repo.
*.sql
backup_*.sql

# ──── Removed secrets, kept only as a local safety copy ────
# `app/token.json` was the one shared Google token. It now lives
# encrypted in `company_integrations`, per company. This is the copy
# taken the day it was removed — delete it once you have reconnected.
_secrets_backup/
